{
	"name": "citizen-docs",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"docs:dev": "vitepress dev",
		"docs:build": "node scripts/build.js",
		"docs:reference": "node scripts/generate-preferences-reference.js",
		"docs:preview": "vitepress preview",
		"format": "oxfmt \"**/*.{ts,js,vue}\"",
		"format:check": "oxfmt --check \"**/*.{ts,js,vue}\"",
		"lint": "npm -s run lint:js && npm -s run lint:md && npm -s run format:check",
		"lint:fix": "npm -s run lint:fix:js && npm -s run lint:fix:md && npm -s run format",
		"lint:js": "oxlint --type-aware",
		"lint:fix:js": "oxlint --type-aware --fix",
		"lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
		"lint:fix:md": "npm run lint:md -- --fix",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@itznotabug/routex": "^0.0.5",
		"@octokit/rest": "^22.0.1",
		"@octokit/types": "^18.0.0",
		"@types/node": "^26.6.2",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vue/test-utils": "^2.5.1",
		"jsdom": "^30.1.0",
		"less": "^4.9.1",
		"markdown-it": "15.0.2",
		"markdownlint-cli": "^0.49.1",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"playwright": "^1.63.0",
		"vitepress": "2.0.0-alpha.20",
		"vitepress-plugin-group-icons": "^1.7.6",
		"vitepress-plugin-llms": "^1.14.0",
		"vitepress-plugin-tabs": "^0.9.1",
		"vitest": "^5.0.1",
		"vue": "^3.5.43"
	}
}
