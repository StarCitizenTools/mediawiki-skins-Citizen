{{!
	object data-page-aside
		array array-panels one entry per panel with content, ordered. Each carries
			panel-id, panel-label, panel-placement, is-<id>, and body — the
			panel's own template data. Flow panels render through the shared
			chrome in PageAsidePanel. The table of contents is the one panel
			that builds that chrome itself: its root is a nav and it carries a
			below-desktop control between heading and body.
	string msg-citizen-page-aside-label accessible name for the landmark
}}
<aside class="citizen-page-aside" aria-label="{{msg-citizen-page-aside-label}}">
	{{#data-page-aside}}
		{{#array-panels}}
			{{#is-toc}}{{#body}}{{>TableOfContents}}{{/body}}{{/is-toc}}
			{{^is-toc}}{{>PageAsidePanel}}{{/is-toc}}
		{{/array-panels}}
	{{/data-page-aside}}
</aside>
